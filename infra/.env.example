# .env.example - Biến môi trường hệ thống
PROJECT_NAME="Hệ thống Vận hành Sản xuất & Thi công Cậu Long"
ENVIRONMENT=production

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://caulong_user:caulong_secret_2026@postgres:5432/caulong_db
# Dùng cho Alembic migration đồng bộ (psycopg2)
SYNC_DATABASE_URL=postgresql://caulong_user:caulong_secret_2026@postgres:5432/caulong_db

# JWT & Bảo mật
SECRET_KEY=change-this-to-a-super-secret-key-at-least-32-chars-long-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Settings (Mặc định)
DEFAULT_AI_PROVIDER=gemini
AI_MONTHLY_BUDGET_USD=50.0
AI_BUDGET_ALERT_THRESHOLD=0.8

# Port cấu hình
API_PORT=8000
WEB_PORT=3000
